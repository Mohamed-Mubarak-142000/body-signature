# Database — Supabase Postgres (project ref: etoshkfpvpndorjbdtns).
# Get the real password from Supabase → Project Settings → Database.
# Pooled (pgbouncer, transaction mode) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.etoshkfpvpndorjbdtns:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (session mode) — used only by `prisma migrate`/`prisma db push`.
DIRECT_URL="postgresql://postgres.etoshkfpvpndorjbdtns:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Auth.js (customer-facing sessions)
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3001"

# Staff bearer tokens — signed here, verified here, carried by the dashboard
# app as an Authorization header (see lib/staff-token.ts). Not the same
# secret as AUTH_SECRET on purpose: rotating one shouldn't log out the other.
STAFF_JWT_SECRET="generate-with: openssl rand -hex 32"

# Google OAuth (customer sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="Body Signature <no-reply@bodysignature.nl>"

# Allowed origin for the dashboard app calling this API (CORS)
DASHBOARD_ORIGIN="http://localhost:3002"
