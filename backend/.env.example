# Database — Supabase Postgres (project ref: etoshkfpvpndorjbdtns).
# Get the real password from Supabase → Project Settings → Database.
# Pooled (pgbouncer, transaction mode) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.etoshkfpvpndorjbdtns:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (session mode) — used only by `prisma migrate`/`prisma db push`.
DIRECT_URL="postgresql://postgres.etoshkfpvpndorjbdtns:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Bearer-token auth (both staff and customers) — signed here, verified here,
# carried by the dashboard/marketing site as an Authorization header. See
# lib/auth-token.ts.
AUTH_TOKEN_SECRET="generate-with: openssl rand -hex 32"

# Shared secret for POST /api/auth/google — only the marketing site's
# server-side NextAuth code should know this. See that route's comment for
# why it can't just trust whatever email a caller claims.
INTERNAL_API_SECRET="generate-with: openssl rand -hex 32"

# Resend (transactional email). Leave RESEND_API_KEY empty for local dev —
# lib/mail.ts's sendMailSafe() logs to the console instead of failing.
RESEND_API_KEY=""
EMAIL_FROM="Body Signature <no-reply@bodysignature.nl>"

# Where contact-form submissions get emailed to staff. Skipped if unset.
CONTACT_NOTIFY_EMAIL=""
